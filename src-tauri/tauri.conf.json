{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Chronicles",
  "version": "0.0.1",
  "identifier": "com.hymetalab.chronicles",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Chronicles",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/jordanheckler-HMM/chronicles/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3NzFCNTY0NzM4N0NFRDEKUldUUnpvZHpaTFZ4OTJZUXNyQXdCaTBCc3B0bkl0SmRsRHZQOTNUT3BET0U4QmFHLzQ1NHdndzAK"
    }
  }
}
